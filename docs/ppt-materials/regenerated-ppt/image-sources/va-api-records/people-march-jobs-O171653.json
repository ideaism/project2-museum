{"meta":{"version":"2.1","_links":{"self":{"href":"https://api.vam.ac.uk/v2/object/O171653"},"collection_page":{"href":"https://collections.vam.ac.uk/item/O171653/"}},"images":{"_primary_thumbnail":"https://framemark.vam.ac.uk/collections/2009BY9655/full/!100,100/0/default.jpg","_iiif_image":"https://framemark.vam.ac.uk/collections/2009BY9655/","_alt_iiif_image":[],"imageResolution":"low","_images_meta":[{"assetRef":"2009BY9655","copyright":"© Victoria and Albert Museum, London","sensitiveImage":false},{"assetRef":"2009BY9654","copyright":"© Victoria and Albert Museum, London","sensitiveImage":false}]},"see_also":null},"record":{"systemNumber":"O171653","accessionNumber":"C.106-1991","objectType":"Mug","titles":[{"title":"Peoples March for Jobs","type":"manufacturer's title"}],"summaryDescription":"","physicalDescription":"'Tankard-style' earthenware mug with pronounced base and slightly curving body. Cream ground with main design in green with smaller, black lettering. A green 'lozenge' shape contains an image of a road with 'Peoples March for Jobs Liverpool-London may 1981'. Also on the lozenge the towns they went through in black i.e., Liverpool, Widnes, Warrington, Salford, Manchester, Stockport, Macclesfield, Congleton, Kidsgrove, Stoke, Stafford, Cannock, Wolverhampton, Walsall, Sandwell, Birmingham, and many others. On the back 'This commemorative mug was issued to mark the great Peoples March for Jobs from Liverpool to London'. Then a further description of the aims of the march and its forebears, and the final words 'March for Jobs! March with Dignity! March for Britain! Liverpool London May 1981'. On the side 'To mark the contribution made by marcher no. 352 ELIZABETH DYKES (number and name hand written) who took part in the historic Peoples March to London May 1981'.","artistMakerPerson":[{"name":{"text":"Unknown","id":"A1848"},"association":{"text":"","id":""},"note":""}],"artistMakerOrganisations":[],"artistMakerPeople":[],"materials":[{"text":"earthenw